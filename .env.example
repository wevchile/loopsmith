# Copy this file to .env and fill in your values. .env is ignored by git.

# Gemini API key (required only for AI generation).
# Create one at https://aistudio.google.com/api-keys
# Without it Loopsmith still runs: projects, folders, the player and manifests work.
GEMINI_API_KEY=your_gemini_api_key_here

# Keys from AI Studio work as is (both the older "AIza..." and the newer "AQ..." formats).
# GOOGLE_CLOUD_PROJECT is NOT needed: Loopsmith uses the Gemini API, not Vertex AI.

# Gemini API version. Lyria is only available on v1beta, so keep the default.
GEMINI_API_VERSION=v1beta

# Lyria model used for music generation. All of these use the Interactions API on v1beta.
#   lyria-3.5             stable, default. Full songs (a couple of minutes), MP3 or WAV. USD 0.08 per song.
#   lyria-3-clip-preview  preview. Always 30 s, MP3 only. Faster. USD 0.04 per clip.
#   lyria-3-pro-preview   preview, previous generation full-song model (Google recommends
#                         lyria-3.5 instead). MP3 only. USD 0.08 per song.
#   lyria-realtime-exp    experimental live streaming model. NOT supported (cannot save files).
# Models list: https://ai.google.dev/gemini-api/docs/models
# Prices: https://ai.google.dev/gemini-api/docs/pricing (no free tier for Lyria)
LYRIA_MODEL=lyria-3.5

# Audio format requested from Lyria: mp3 (default) or wav. Only lyria-3.5 can return wav;
# the other models always return mp3.
LYRIA_OUTPUT_FORMAT=mp3

# Lyria has no duration parameter: it only takes the length as a hint in the prompt.
# When you fill in the duration field, Loopsmith cuts longer results to that length with a
# short fade-out. Uses ffmpeg if installed (best quality), otherwise a built-in cutter
# (WAV with fade-out, MP3 cut at a frame without fade-out).
LOOPSMITH_TRIM_TO_DURATION=true
# Keep the full model output in <project>/.loopsmith-untrimmed (hidden from the track list).
LOOPSMITH_KEEP_UNTRIMMED=true
LOOPSMITH_FADE_OUT_SECONDS=1.5
# Path to ffmpeg if it is not on PATH, or "off" to always use the built-in cutter.
# LOOPSMITH_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe

# Gemini model that listens to a track when you use it as the base of a variant.
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash

# Folders where projects are created (comma separated). Relative paths are resolved
# from the repository folder. The first one is the default for new projects.
# Example (Windows): LOOPSMITH_ROOTS=./loopsmith-data,D:\music\games
LOOPSMITH_ROOTS=./loopsmith-data

# Ports. The server always listens on 127.0.0.1 only.
LOOPSMITH_SERVER_PORT=3001
LOOPSMITH_WEB_PORT=3000

# Open the browser automatically when running "pnpm dev" (true or false).
LOOPSMITH_OPEN_BROWSER=true
