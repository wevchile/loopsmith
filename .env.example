# Copy this file to .env and fill in your values. .env is ignored by git.

# Gemini API key (required only for AI generation).
# Create one at https://aistudio.google.com/api-keys
# Without it Loopsmith still runs: projects, folders, the player and manifests work.
GEMINI_API_KEY=your_gemini_api_key_here

# Lyria model used for music generation.
#   lyria-3.5             full-length tracks (default, stable)
#   lyria-3-clip-preview  30 second clips, faster and cheaper (preview)
# Model list: https://ai.google.dev/gemini-api/docs/models
LYRIA_MODEL=lyria-3.5

# Audio format requested from Lyria: mp3 (default) or wav.
LYRIA_OUTPUT_FORMAT=mp3

# Gemini model that listens to a track when you use it as the base of a variant.
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash

# Folders where projects are created (comma separated). Relative paths are resolved
# from the repository folder. The first one is the default for new projects.
# Example (Windows): LOOPSMITH_ROOTS=./loopsmith-data,D:\music\games
LOOPSMITH_ROOTS=./loopsmith-data

# Ports. The server always listens on 127.0.0.1 only.
LOOPSMITH_SERVER_PORT=3001
LOOPSMITH_WEB_PORT=3000

# Open the browser automatically when running "pnpm dev" (true or false).
LOOPSMITH_OPEN_BROWSER=true
